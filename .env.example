# Copy to `.env` and fill in. Every variable degrades one feature when absent —
# none of them take the site down. See docs/backend-setup.md for where each
# value comes from.

# Optional Google Search Console HTML-tag verification. Paste only the content
# value, not the whole <meta> tag. DNS-verified Domain properties do not need it.
GOOGLE_SITE_VERIFICATION=""

# Postgres. Neon's *pooled* connection string, or any Postgres URL.
# Required by: lead capture, admin login, assistant rate limit.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Signing key for the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required by: admin login. Rotating it logs every admin out.
SESSION_SECRET=""

# Groq, for the homepage assistant. https://console.groq.com/keys
# Absent: the endpoint returns 503 and the panel says it isn't connected.
# Groq retires models — check the name is still served before deploying, because
# one it no longer offers returns a 400 that reads as "assistant unavailable".
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# SMTP, for the lead notification email. For Gmail: turn on 2-Step Verification,
# then make a 16-character app password at https://myaccount.google.com/apppasswords
# Absent: leads are still saved, the email is skipped.
# Port 465 is implicit TLS, 587 is STARTTLS — the code derives which from the number.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="hashmetrik@gmail.com"
SMTP_PASS=""
# Gmail rewrites From: to the authenticated account, so on Gmail these must match
# SMTP_USER. On a host that allows it, LEAD_FROM_EMAIL can be anything you own.
LEAD_FROM_EMAIL="Hashmetrik <hashmetrik@gmail.com>"
LEAD_NOTIFY_EMAIL="hashmetrik@gmail.com"

# Google Sheets, for the copy of every enquiry. A service account with the Sheets
# API enabled; see docs/backend-setup.md for the six clicks that produce it.
# Absent: leads are still saved and still emailed, the row is skipped.
# The spreadsheet must be shared with GOOGLE_SERVICE_ACCOUNT_EMAIL as an Editor.
GOOGLE_SHEETS_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# The `private_key` from the downloaded JSON, verbatim — keep the \n escapes and
# the quotes, the code turns them back into newlines.
GOOGLE_PRIVATE_KEY=""
# The tab within the spreadsheet. Defaults to Leads when blank.
GOOGLE_SHEETS_TAB="Leads"

# Read once by `prisma db seed` to create the first admin, then removable.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
